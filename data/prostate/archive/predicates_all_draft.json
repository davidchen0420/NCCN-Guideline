"risk_group": "enum: \"low\"|\"intermediate\"|\"high\"|\"very_high\". NCCN risk group for clinically localized disease, derived from clinical/pathologic features",
"clinical_t_stage": "enum: \"T1\"|\"T2a\"|\"T2b\"|\"T2c\"|\"T3\"|\"T4\". Clinical T stage",
"grade_group": "number 1-5. ISUP/NCCN Grade Group",
"psa_ng_ml": "number. Serum PSA at diagnosis, ng/mL",
"biopsy_positive_core_percent": "number 0-100. Percent of biopsy cores positive",
"irf_count": "number 0-3. Count of intermediate risk factors present: cT2b-cT2c, Grade Group 2-3, PSA 10-20 ng/mL",
"high_risk_feature_count": "number 0-3. Count of high-risk features present: cT3-cT4, Grade Group 4-5, PSA >20 ng/mL",
"very_high_risk_feature_count": "number 0-3. Count of very-high-risk features present: cT3-cT4, Grade Group 4-5, PSA >40 ng/mL",
"symptomatic": "bool. Patient has symptoms attributable to prostate cancer or its progression",
"castration_resistant": "bool. Castration-resistant prostate cancer (CRPC); false = castration-sensitive (CSPC)",
"synchronous_m1": "bool. M1 disease present at initial diagnosis (true = synchronous, false = metachronous)",
"initial_adt_months": "number. Months of androgen deprivation therapy given with initial radiation therapy; 0 if none",
"initial_adt_only": "bool. Initial definitive treatment is ADT alone (no radical prostatectomy or radiation therapy)",
"currently_on_adt": "bool. Patient is currently receiving androgen deprivation therapy",
"second_bcr": "bool. Second biochemical recurrence (rising PSA after a prior biochemical recurrence)",
"prior_arpi": "bool. Prior androgen receptor pathway inhibitor (abiraterone, enzalutamide, apalutamide, darolutamide) for prostate cancer",
"prior_docetaxel": "bool. Prior docetaxel chemotherapy for prostate cancer",
"msi_h_dmmr": "bool. Tumor is MSI-High or mismatch repair deficient (dMMR)",
"histology": "enum: \"adenocarcinoma\"|\"small_cell_neuroendocrine\". Histologic subtype of metastatic prostate cancer"
},
